# ============================================================
# Market registry: US equities and Bursa Malaysia (A-share settings stay in params.yaml)
# Copy to markets.yaml to customise; without it the loader reads this template.
# API keys never go here: set environment variables, or config/params.yaml → data.api_keys
#   EODHD_API_KEY   needed only when a provider below is "eodhd"
#   SEC_USER_AGENT  "Your Name your@email.com" (SEC rejects requests without it)
# Update data:  python data/market_update.py --market US     (see docs/markets-data.md)
# ============================================================
markets:
  US:
    name: US equities
    currency: USD
    calendar: XNYS                    # exchange_calendars code
    history_start: "2010-01-01"
    benchmark: {code: SPY}
    providers:
      bars: yahoo                     # yahoo: free, no delisted tickers | eodhd: paid key, includes delisted
      symbols: nasdaqtrader           # nasdaqtrader: free, current listings | eodhd | seed
      fundamentals: sec_edgar         # SEC XBRL company facts, point-in-time by filing date
      macro: fred                     # keyless CSV, latest vintage
    provider_symbols:                 # canonical BRK.B.US → provider ticker
      yahoo: {suffix: "", class_separator: "-"}
      eodhd: {suffix: ".US", class_separator: "-", exchange: US}
      sec_edgar: {suffix: "", class_separator: "-"}
    universe:
      default: seed                   # seed: the list below | all: symbol master after filters
      include_etfs: true
      exclude_name_patterns:          # case-insensitive regex on the security name
        - '\bwarrants?\b'
        - '\bunits?\b'
        - '\brights?\b'
        - '\bpreferred\b'
        - '\bnotes?\b'
        - '\bdebentures?\b'
        - '\bacquisition corp'
        - 'depositary shares, each representing a \d+/\d+'
        # partnerships: non-US holders suffer 10% withholding on gross sale proceeds
        - '\bL\.?P\.?\b'
        - 'limited partnership'
      seed: [QQQ, IWM, VTI, SMH, XLK, SCHD, GLD, TLT,
             AAPL, MSFT, NVDA, GOOGL, AMZN, META, TSLA, AVGO,
             AMD, TSM, ASML, MU, QCOM, ARM,
             ORCL, CRM, ADBE, NOW, NFLX, PLTR, UBER, SHOP,
             JPM, BRK.B, V, MA, GS, BAC,
             LLY, UNH, JNJ, ABBV, ISRG, NVO,
             COST, WMT, KO, PEP, MCD, NKE, DIS,
             XOM, CVX, CAT, GE, BA]
    fundamentals:
      # SEC frames: one request per period for every filer; the latest filed value (restatements
      # replace originals), used from period end + frame_lag_days. Feeds the fundamental factors.
      frames:
        - {field: equity, concept: "us-gaap:StockholdersEquity", unit: USD, period: quarter_instant}
        - {field: assets, concept: "us-gaap:Assets", unit: USD, period: quarter_instant}
        - {field: net_income, concept: "us-gaap:NetIncomeLoss", unit: USD, period: year}
      frame_lag_days: 90
      refresh_days: 7                 # skip companies refreshed more recently than this
      concepts:
        - dei:EntityCommonStockSharesOutstanding
        - us-gaap:CommonStockSharesOutstanding
        - us-gaap:Revenues
        - us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax
        - us-gaap:NetIncomeLoss
        - us-gaap:EarningsPerShareDiluted
        - us-gaap:Assets
        - us-gaap:Liabilities
        - us-gaap:StockholdersEquity
        - us-gaap:NetCashProvidedByUsedInOperatingActivities
        - us-gaap:LongTermDebt
    macro:
      # CPIAUCSL and UNRATE get revised: the keyless CSV holds the latest vintage only
      series: [DGS10, DGS2, T10Y2Y, FEDFUNDS, VIXCLS, BAMLH0A0HYM2, USEPUINDXD, CPIAUCSL, UNRATE]
    shares:                           # shares outstanding → daily turnover
      # yahoo: per ticker from ~2015, right for ADRs and share classes
      # sec_edgar: cover-page counts from 2009, used only for earlier years where both sources agree
      sources: [yahoo, sec_edgar]
      lag_days: {yahoo: 7, sec_edgar: 35}   # SEC frames carry no filing date
      refresh_days: 30
      reliable_from: "2016-01-01"     # turnover factors are validated from here (Yahoo history begins ~2015)
      # only single-ticker 10-Q filers get turnover: ADRs/foreign issuers (no 10-Q) and multi-class
      # tickers have share counts covering shares traded abroad or in another class
      domestic_only: true
    rules:
      lot_size: null                  # fractional shares (moomoo MY); no lot rounding
      price_limit: null               # no daily limit (LULD pauses only)
      tick_sizes: [[0, 0.0001], [1.0, 0.01]]   # [from price, tick]: $0.0001 under $1, else 1 cent
    costs:                            # per side, in USD; moomoo MY schedule (docs/RnD-US-Malaysia.md §1)
      commission_pct: 0.0003
      platform_fee: 0.99              # per order, on top of commission
      stamp_duty_pct: 0.001           # Malaysian stamp duty on the contract note
      stamp_duty_max: 230             # RM1,000 cap in USD; adjust when USD/MYR moves
      sell_fee_pct: 0.0000206         # SEC Section 31 fee, sells only
      slippage_pct: 0.0005
    validation:                       # 9-step chain: python backtest/market_validation.py --market US
      start: "2012-01-01"
      holdout_start: "2023-01-01"
      top_n: 20
      rebalance_days: 40              # also the IC horizon
      capital: 100000                 # drives lot rounding and minimum fees
      participation: 0.05             # capacity: max share of a stock's daily dollar volume
      filters: {min_price: 5, min_dollar_volume: 5000000, min_history_days: 252, exclude_etfs: true}
      factors:                        # sign +1: higher is better, -1: lower is better
        - {name: turn_20, sign: -1}
        - {name: lowvol_60, sign: -1}
        - {name: mom_20, sign: -1}
        - {name: mom_12_1, sign: 1}
        - {name: near_high_250, sign: 1}
        - {name: amihud_20, sign: 1}
        - {name: max_ret_20, sign: -1}
        - {name: book_to_price, sign: 1}
        - {name: earnings_yield, sign: 1}
        - {name: roa, sign: 1}
        - {name: asset_growth, sign: -1}
    pitch:                            # decision cards: python strategy/market_pitch.py --market US
      top_n: 10
      capital: 100000                 # position size = capital / positions
      positions: 10
      # composite score = weighted mean of percentile ranks; factors graded "invalid" in the
      # latest validation are dropped automatically (picked from the 2026-10-06 validation)
      factors:
        - {name: near_high_250, sign: 1, weight: 1}
        - {name: turn_20, sign: -1, weight: 1}
        - {name: max_ret_20, sign: -1, weight: 1}
    positions:                        # holdings ledger and daily exit checks (strategy/market_positions.py)
      # risk/stop_rules.py thresholds; the card stop uses stop_loss_pct. Only the hard stop and the
      # rebalance exit match the validated strategy; drawdown and take-profit are extra alerts.
      stop_rules: {stop_loss_pct: 0.15, high_drawdown_exit: 0.25, profit_take_low: 0.50, profit_take_high: 1.00}
    # L0 regime settings (strategy/timing.py RegimeDetector; unset = the A-share defaults:
    # crisis_vol 0.30, confirm_days 5, cash_map 0/20/50/80/100%). Checked by backtest/market_timing.py:
    # on SPY 2012–2026 the overlay halved drawdown but cut Sharpe 0.94 → 0.67, so it informs, not gates
    timing: {gate_new_positions: false}
    calendar_windows: {}

  MY:
    name: Bursa Malaysia
    currency: MYR
    calendar: XKLS
    history_start: "2010-01-01"
    benchmark: {code: KLCI, yahoo: "^KLSE", eodhd: KLSE.INDX}
    providers:
      bars: yahoo                     # yahoo drops delisted counters → backtests overstate returns
      symbols: yahoo                  # Yahoo screener, current listings | eodhd incl. delisted (paid key) | seed
    macro:                            # free, no key: Bank Negara OpenAPI and OpenDOSM
      series:
        - {id: OPR, provider: bnm, endpoint: opr}
        - {id: USDMYR, provider: bnm, endpoint: fx, currency: USD}
        - {id: MY_CPI, provider: opendosm, dataset: cpi_headline, filter: {division: overall}, value: index}
    provider_symbols:
      yahoo: {suffix: ".KL", class_separator: "-", exchange: KLS}
      eodhd: {suffix: ".KLSE", class_separator: "-", exchange: KLSE}
    universe:
      default: seed
      include_etfs: true
      code_pattern: '^\d{4}(EA)?$'    # ordinary shares, REITs, ETFs; drops warrants and structured warrants
      exclude_name_patterns: ['\bwarrants?\b']
      # optional CSV lists with a "code" column (templates in config/lists/*.example); a missing file
      # means no filter. Today's list is applied to history too, so validation with it has look-ahead.
      list_filters:
        exclude: [config/lists/my_pn17_gn3.csv]   # distressed companies
        require: []                               # [config/lists/my_shariah.csv] for a Shariah-only universe
      # quoted so leading zeros survive (0166 = Inari Amertron)
      seed: ["1155", "1295", "1023", "5819", "1066", "5347", "6742", "6033", "5183", "8869",
             "5225", "5398", "5211", "0166", "6947", "6012", "4863", "6888", "5296", "4707",
             "2445", "1961", "5285", "4197", "3182"]
    shares:
      sources: [yahoo]                # Yahoo history starts in 2023; earlier dates reuse the first count
      lag_days: {yahoo: 7}
      refresh_days: 30
      reliable_from: "2023-06-01"     # earlier turnover reuses a later share count → not validated
    rules:
      lot_size: 100
      price_limit: {pct: 0.30, below_price: 1.0, abs: 0.30}   # ±30%, or ±30 sen under RM1
      tick_sizes: [[0, 0.005], [1.0, 0.01], [10.0, 0.02], [100.0, 0.10]]   # Bursa bid sizes
    costs:                            # per side, in MYR; moomoo MY + Bursa (docs/RnD-US-Malaysia.md §1)
      commission_pct: 0.0003
      platform_fee: 3.0               # per order, on top of commission
      clearing_pct: 0.0003
      clearing_max: 1000
      stamp_duty_pct: 0.001
      stamp_duty_step: 1000           # RM1 per RM1,000 or part of it
      stamp_duty_max: 1000
      slippage_pct: 0.002
    validation:
      start: "2012-01-01"
      holdout_start: "2023-01-01"
      top_n: 20
      rebalance_days: 40
      capital: 50000
      participation: 0.05
      filters: {min_price: 0.20, min_dollar_volume: 200000, min_history_days: 252, exclude_etfs: true}
      factors:
        - {name: turn_20, sign: -1}
        - {name: lowvol_60, sign: -1}
        - {name: mom_20, sign: -1}
        - {name: mom_12_1, sign: 1}
        - {name: near_high_250, sign: 1}
        - {name: amihud_20, sign: 1}
        - {name: max_ret_20, sign: -1}
    pitch:
      top_n: 10
      capital: 50000
      positions: 10
      factors:
        - {name: near_high_250, sign: 1, weight: 1}
        - {name: mom_12_1, sign: 1, weight: 1}
        - {name: lowvol_60, sign: -1, weight: 1}
    positions:                        # holdings ledger and daily exit checks (strategy/market_positions.py)
      # risk/stop_rules.py thresholds; the card stop uses stop_loss_pct. Only the hard stop and the
      # rebalance exit match the validated strategy; drawdown and take-profit are extra alerts.
      stop_rules: {stop_loss_pct: 0.15, high_drawdown_exit: 0.25, profit_take_low: 0.50, profit_take_high: 1.00}
    timing: {gate_new_positions: false}   # KLCI 2012–2026: overlay Sharpe 0.09 → -0.10
    calendar_windows:
      # lunar holidays move every year: approximate first days, snapped to the Bursa closure within ±3 days
      named_holidays:
        chinese_new_year: ["2012-01-23", "2013-02-10", "2014-01-31", "2015-02-19", "2016-02-08", "2017-01-28",
                           "2018-02-16", "2019-02-05", "2020-01-25", "2021-02-12", "2022-02-01", "2023-01-22",
                           "2024-02-10", "2025-01-29", "2026-02-17"]
        hari_raya_aidilfitri: ["2012-08-19", "2013-08-08", "2014-07-28", "2015-07-17", "2016-07-06", "2017-06-25",
                               "2018-06-15", "2019-06-05", "2020-05-24", "2021-05-13", "2022-05-03", "2023-04-22",
                               "2024-04-10", "2025-03-31", "2026-03-21"]
